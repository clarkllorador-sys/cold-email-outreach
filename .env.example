# ── Lead scraping ─────────────────────────────────────────────────────────────
# Bright Data CLI auth (run: bdata login)
# No env var needed — bdata reads from ~/.brightdata/config

# ── Google Sheets (CRM) ───────────────────────────────────────────────────────
GOOGLE_SHEETS_KEY_FILE=credentials/service_account.json
GOOGLE_SHEETS_ID=

# ── ElevenLabs (TTS audio) ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Loom (headshot video download) ────────────────────────────────────────────
LOOM_COOKIE=connect.sid=s%3A...
# Or: full storage state from save_loom_cookies.py
LOOM_AUTH_FILE=credentials/loom_auth.json

# ── Google Drive (video/audio uploads) ────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=
# OAuth credentials for Drive (reuses Gmail token — no service account quota)
GMAIL_CREDENTIALS_FILE=credentials/oauth_client.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json
# Drive file ID of the host's template audio recording
TEMPLATE_DRIVE_FILE_ID=

# ── Email sending ─────────────────────────────────────────────────────────────
# Option A: Gmail API (single account)
GMAIL_FROM=you@yourdomain.com

# Option B: SMTP multi-account (send_emails_multi_acct.py)
SENDER_1_FROM=you@sender1.com
SENDER_1_PASSWORD=
SENDER_1_HOST=mail.sender1.com

SENDER_2_FROM=you@sender2.com
SENDER_2_PASSWORD=
SENDER_2_HOST=mail.sender2.com

SENDER_3_FROM=you@sender3.com
SENDER_3_PASSWORD=
SENDER_3_HOST=mail.sender3.com

SMTP_PORT=465

# ── Booking / CTA link ────────────────────────────────────────────────────────
BOOKING_URL=https://cal.example.com/free-consultation
